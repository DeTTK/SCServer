import { AboutSlint } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Action, Hint, Icon, Label, Rule, SectionTitle } from "controls.slint";

component Destination inherits FocusScope {
    in property <string> title;
    in property <string> detail;
    in property <string> glyph;
    callback activated;
    height: 66px;
    accessible-role: button;
    accessible-label: root.title + ". " + root.detail;
    accessible-action-default => { root.activated(); }
    key-pressed(event) => {
        if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
        return reject;
    }
    Rectangle {
        background: tap.pressed ? Theme.pressed : tap.has-hover ? Theme.hover : Theme.raised;
        border-width: 1px;
        border-color: root.has-focus ? Theme.focus : Theme.rule;
        border-radius: 5px;
        HorizontalLayout {
            padding-left: 16px; padding-right: 16px; spacing: 14px;
            Icon { width: 24px; font-size: 21px; color: Theme.text; text: root.glyph; }
            VerticalLayout {
                alignment: center; spacing: 2px;
                Label { text: root.title; font-weight: 650; font-size: 16px; }
                Hint { text: root.detail; }
            }
            Icon { width: 17px; font-size: 14px; text: "\u{e8a7}"; }
        }
    }
    tap := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
}

export component AboutProject inherits Rectangle {
    in property <string> version;
    callback project-link(string);
    callback dismiss;
    background: Theme.panel;
    border-radius: 8px; clip: true;
    HorizontalLayout {
        Rectangle {
            width: 300px; clip: true; background: Theme.canvas;
            Image {
                source: @image-url("assets/brand-character.png");
                image-fit: cover; height: parent.height; width: parent.width;
            }
            Rectangle { background: @linear-gradient(180deg, #08080bdf 0%, #08080b66 34%, #08080b08 55%, #08080bf5 100%); }
            VerticalLayout {
                x: 24px; y: parent.height - 84px; width: parent.width - 48px; height: 60px;
                alignment: center; spacing: 4px;
                Label { text: "BSCPCRAFT"; font-family: Theme.display-font; font-size: 24px; }
                Hint { text: "Лаунчер  /  " + root.version; color: Theme.accent-pressed; }
            }
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.rule; }
        }
        VerticalLayout {
            padding-left: 24px; padding-right: 24px; padding-top: 22px; padding-bottom: 12px; spacing: 8px;
            SectionTitle { text: "О проекте"; font-size: 24px; height: 36px; }
            Hint { text: "Сообщество и разработка"; height: 23px; }
            for link in [
                {id: "telegram", title: "Telegram-канал", detail: "Новости и обновления проекта", glyph: "\u{e724}"},
                {id: "feedback", title: "Обратная связь", detail: "Вопросы и предложения в Telegram", glyph: "\u{e8f2}"},
                {id: "github", title: "GitHub", detail: "Исходный код сервера", glyph: "\u{e943}"}
            ]: Destination {
                title: link.title; detail: link.detail; glyph: link.glyph;
                activated => { root.project-link(link.id); }
            }
            Rectangle { min-height: 0px; vertical-stretch: 1; }
            Rule {}
            HorizontalLayout {
                height: 96px;
                AboutSlint { width: 140px; }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Action { width: 116px; label: "Закрыть"; activated => { root.dismiss(); } }
                }
            }
        }
    }
    Rectangle { border-width: 1px; border-color: Theme.outline; border-radius: 8px; }
}
