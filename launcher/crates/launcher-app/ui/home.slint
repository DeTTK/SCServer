import { WorldRow, ServerRow, PublicServerRow, ChangeRow } from "api.slint";
import { Theme } from "theme.slint";
import { Action, Entry, EmptyState, Hint, Icon, Label, Rule, RowButton, SectionTitle, Scroller } from "controls.slint";

export component Home inherits HorizontalLayout {
    in property <[WorldRow]> worlds;
    in property <[ServerRow]> favorites;
    in property <[ServerRow]> server-history;
    in property <[PublicServerRow]> public-servers;
    in property <string> directory-message;
    in-out property <string> server-tab;
    in property <[ChangeRow]> changes;
    in property <string> world-id;
    in property <string> world-title;
    in-out property <string> address;
    in property <bool> busy;
    in property <length> server-column-width: 320px;
    callback select-world(string);
    callback manage-worlds;
    callback connect(string);
    callback add-favorite;
    callback remove-favorite(string);
    private property <bool> show-history: root.server-tab == "history";
    private property <bool> show-public: root.server-tab == "public";
    private property <bool> show-favorites: !root.show-history && !root.show-public;
    private property <[ServerRow]> servers: show-history ? server-history : favorites;
    spacing: 22px;
    VerticalLayout {
        min-width: 290px; horizontal-stretch: 6; spacing: 18px;
        hero := Rectangle {
            height: clamp(parent.width * 0.42, 204px, 320px);
            background: #000000; border-radius: 7px; clip: true;
            Image { source: @image-url("assets/brand-character.png"); image-fit: contain; x: parent.width * 0.14; width: parent.width * 0.86; height: parent.height; }
            Rectangle { background: @linear-gradient(180deg, #00000000 34%, #0000008c 66%, #000000f5 100%); }
            hero-content := HorizontalLayout {
                x: 18px; y: parent.height - self.height - 16px;
                width: parent.width - 36px; height: 48px; spacing: 12px;
                VerticalLayout {
                    alignment: center; horizontal-stretch: 1;
                    Hint { text: "Мир для запуска"; color: Theme.text; height: 19px; }
                    Label { text: root.world-title == "" ? "Мир не выбран" : root.world-title; font-size: 24px; font-weight: 650; height: 31px; }
                }
                Rectangle {
                    width: 108px; height: 38px;
                    Action { label: "Сменить"; glyph: "\u{e70d}"; width: parent.width; activated => {
                        if root.worlds.length > 0 { picker.show(); } else { root.manage-worlds(); }
                    } }
                    picker := PopupWindow {
                        x: parent.width - self.width; y: parent.height + 4px;
                        width: 300px; height: min(286px, 16px + root.worlds.length * 62px);
                        Rectangle {
                            background: Theme.panel; border-color: Theme.outline; border-width: 1px; border-radius: Theme.radius;
                            Scroller {
                                x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
                                VerticalLayout {
                                    for w in root.worlds: RowButton { title: w.title; detail: w.detail; selected: w.id == root.world-id; activated => { root.select-world(w.id); picker.close(); } }
                                }
                            }
                        }
                    }
                }
            }
        }
        SectionTitle { text: "Что нового"; height: 30px; }
        Rule {}
        Scroller {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start; spacing: 14px;
                if root.changes.length == 0: EmptyState { title: "Записей пока нет"; detail: "Здесь появятся изменения игры из журнала выпуска."; }
                for note in root.changes: HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 5px;
                        Rectangle { y: 8px; width: 5px; height: 5px; border-radius: 1px; background: Theme.accent; }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Label { text: note.title; font-size: 16px; font-weight: 600; wrap: word-wrap; overflow: clip; }
                        Hint { text: note.body; wrap: word-wrap; overflow: clip; }
                    }
                }
            }
        }
    }
    Rectangle {
        width: root.server-column-width;
        background: Theme.panel; border-radius: 7px;
        VerticalLayout {
            padding: 18px; spacing: 14px;
            SectionTitle { text: "Серверы"; height: 30px; }
            HorizontalLayout {
                spacing: 6px; height: 38px; alignment: start;
                Action { label: "Избранные"; kind: "plain"; selected: root.show-favorites; activated => { root.server-tab = "favorites"; } }
                Action { label: "История"; kind: "plain"; selected: root.show-history; activated => { root.server-tab = "history"; } }
                Action { label: "Открытые"; kind: "plain"; selected: root.show-public; activated => { root.server-tab = "public"; } }
            }
            Rule {}
            Scroller {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 4px; alignment: start;
                    if root.show-public && root.public-servers.length == 0: EmptyState {
                        title: root.directory-message == "" ? "Открытых серверов пока нет" : root.directory-message;
                        detail: root.directory-message == "" ? "Здесь появятся миры, опубликованные игроками." : "";
                    }
                    for s in (root.show-public ? root.public-servers : []): RowButton {
                        enabled: !root.busy; title: s.title; detail: s.players; meta: s.ping; online: s.online;
                        glyph: "\u{e839}"; row-icon: s.icon; has-icon: s.has-icon; wrap-title: true;
                        selected: s.address == root.address;
                        activated => { root.address = s.address; }
                    }
                    if !root.show-public && root.servers.length == 0: VerticalLayout {
                        padding-top: 10px; spacing: 12px;
                        EmptyState {
                            title: root.show-history ? "История пока пуста" : "Нет избранных серверов";
                            detail: root.show-history ? "Здесь появятся серверы, к которым вы подключались." : "Добавьте адрес сервера, чтобы вернуться к нему позже.";
                        }
                        if !root.show-history: HorizontalLayout {
                            alignment: start;
                            Action { label: "Добавить сервер"; glyph: "\u{e710}"; enabled: !root.busy; activated => { root.add-favorite(); } }
                        }
                    }
                    for s in (root.show-public ? [] : root.servers): HorizontalLayout {
                        spacing: 4px;
                        RowButton {
                            horizontal-stretch: 1;
                            enabled: !root.busy; title: s.title == "" ? s.address : s.title;
                            detail: s.title == "" ? "" : s.address; meta: s.status; online: s.online;
                            glyph: "\u{e839}"; selected: s.address == root.address && root.address != "";
                            activated => { root.address = s.address; }
                        }
                        if root.show-favorites: VerticalLayout {
                            width: 32px; alignment: center;
                            Action {
                                width: 32px; glyph: "\u{e74d}"; kind: "plain";
                                accessible-label: "Удалить из избранного";
                                enabled: !root.busy;
                                activated => { root.remove-favorite(s.address); }
                            }
                        }
                    }
                }
            }
            if root.show-favorites && root.servers.length > 0: HorizontalLayout {
                alignment: start;
                Action { label: "Добавить сервер"; glyph: "\u{e710}"; kind: "plain"; enabled: !root.busy; activated => { root.add-favorite(); } }
            }
            Rule {}
            Label { text: "Адрес подключения"; font-weight: 600; height: 20px; }
            Entry {
                label: "Адрес подключения"; placeholder: "IP или домен · порт необязателен"; value <=> root.address;
                enabled: !root.busy; accepted => { if root.address != "" { root.connect(root.address); } }
            }
        }
    }
}



