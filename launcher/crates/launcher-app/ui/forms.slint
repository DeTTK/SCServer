import { TransferView } from "api.slint";
import { Theme } from "theme.slint";
import { ComboBox, CheckBox } from "std-widgets.slint";
import { Action, Field, Hint, Label, Notice, Rule, Scroller, SectionTitle, TransferStatus } from "controls.slint";

export component Configuration inherits VerticalLayout {
    in property <bool> wizard;
    in property <int> step;
    in property <bool> busy;
    in property <string> error;
    in property <string> error-field;
    in property <TransferView> transfer-view;
    in property <string> progress-text;
    in property <string> status;
    in property <float> progress: -1;
    in-out property <string> tab: "basic";
    in-out property <string> game-path;
    in-out property <string> data-path;
    in-out property <string> nickname;
    in-out property <string> bundle-path;
    in-out property <string> client-path;
    in-out property <string> server-path;
    in-out property <string> client-memory;
    in-out property <string> server-memory-setting;
    in-out property <string> port;
    in-out property <bool> relay-enabled;
    in-out property <string> feed-url;
    in-out property <string> game-branch;
    in property <[string]> branches;
    in-out property <string> first-world-name;
    in-out property <bool> desktop-shortcut: true;
    private property <bool> inline-error:
        ((root.wizard ? root.step == 0 : root.tab == "basic") && (root.error-field == "game" || root.error-field == "data" || root.error-field == "nick"))
        || (root.wizard && (root.step == 2 && root.error-field == "world"))
        || (!root.wizard && ((root.tab == "client" && (root.error-field == "client" || root.error-field == "cmem"))
            || (root.tab == "server" && (root.error-field == "server" || root.error-field == "smem" || root.error-field == "port"))
            || (root.tab == "updates" && root.error-field == "feed")));
    changed game-branch => { if root.wizard && root.step == 1 { root.bundle-path = ""; } }
    callback browse(string);
    callback install(string);
    callback step-action(string);
    callback update(string);
    callback save;
    spacing: 18px;
    if !root.wizard: HorizontalLayout {
        height: 38px; spacing: 6px; alignment: start;
        for item in [{id:"basic", name:"Основное"}, {id:"client", name:"Клиент"}, {id:"server", name:"Сервер"}, {id:"updates", name:"Обновления"}]: Action {
            label: item.name; selected: root.tab == item.id; kind: "plain";
            activated => { root.tab = item.id; }
        }
    }
    if !root.wizard: Rule {}
    Scroller {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start; spacing: 18px; padding-right: 4px;
            SectionTitle {
                text: root.wizard ? (root.step == 0 ? "Расположение и профиль" : root.step == 1 ? "Игровые компоненты" : "Первый мир")
                    : root.tab == "basic" ? "Расположение и профиль" : root.tab == "client" ? "Игровой клиент" : root.tab == "server" ? "Параметры сервера" : "Канал обновлений";
                height: 32px;
            }
            if (root.wizard && root.step == 0) || (!root.wizard && root.tab == "basic"): VerticalLayout {
                spacing: 18px;
                Field { label: "Папка установленной игры"; value <=> root.game-path; folder: true; hint: "Укажите папку игры из Steam или обычного лаунчера."; enabled: !root.busy; error: root.error-field == "game" ? root.error : ""; browse => { root.browse("game"); } }
                Field { label: "Папка данных и миров"; value <=> root.data-path; folder: true; hint: "Здесь сохраняются миры, настройки и журналы."; enabled: !root.busy; error: root.error-field == "data" ? root.error : ""; browse => { root.browse("data"); } }
                Field { label: "Ник в игре"; value <=> root.nickname; enabled: !root.busy; error: root.error-field == "nick" ? root.error : ""; }
                Label { text: "Ветка игры"; }
                ComboBox { model: root.branches; current-value <=> root.game-branch; enabled: !root.busy; height: 38px; }
                Hint { text: "main — стабильная сборка, launtest — патчи из тестовой ветки. После выбора нажмите «Сохранить», затем обновите игру на вкладке «Обновления»."; wrap: word-wrap; overflow: clip; }
            }
            if root.wizard && root.step == 1: VerticalLayout {
                spacing: 18px;
                Label { text: "Ветка игры"; }
                ComboBox { model: root.branches; current-value <=> root.game-branch; enabled: !root.busy; height: 38px; }
                Hint { text: "Лаунчер установит клиент, сервер, Java и шаблон для новых миров. Уже имеющиеся файлы используются повторно."; wrap: word-wrap; overflow: clip; }
                HorizontalLayout {
                    spacing: 8px; alignment: start;
                    Action { label: root.bundle-path == "" ? "Установить игру" : "Проверить файлы"; glyph: "\u{e896}"; enabled: !root.busy; activated => { root.install("download"); } }
                }

            }
            if root.wizard && root.step == 2: VerticalLayout {
                spacing: 16px;
                Field { label: "Название первого мира"; value <=> root.first-world-name; enabled: !root.busy; error: root.error-field == "world" ? root.error : ""; }
                HorizontalLayout {
                    alignment: start;
                    Action {
                        label: "Создать ярлык BSCPCRAFT на рабочем столе";
                        kind: "plain"; align-left: true; accessible-role: checkbox;
                        checkable: true; checked: root.desktop-shortcut;
                        glyph: root.desktop-shortcut ? "\u{e73d}" : "\u{e739}";
                        enabled: !root.busy; activated => { root.desktop-shortcut = !root.desktop-shortcut; }
                    }
                }
                Hint { text: "Ярлык запустит этот лаунчер с выбранной папкой данных."; wrap: word-wrap; overflow: clip; }
                Rule {}
                for row in [{name:"Игра", val:root.game-path},{name:"Данные и миры", val:root.data-path},{name:"Ветка игры", val:root.game-branch},{name:"Игрок", val:root.nickname}]: VerticalLayout {
                    spacing: 2px; Hint { text: row.name; } Label { text: row.val; wrap: word-wrap; overflow: clip; }
                }
            }
            if !root.wizard && root.tab == "client": VerticalLayout {
                spacing: 18px;
                Field { label: "Память клиента, МБ"; value <=> root.client-memory; enabled: !root.busy; error: root.error-field == "cmem" ? root.error : ""; }
                Field { label: "Папка клиентского комплекта"; value <=> root.client-path; folder: true; enabled: !root.busy; error: root.error-field == "client" ? root.error : ""; browse => { root.browse("client"); } }
            }
            if !root.wizard && root.tab == "server": VerticalLayout {
                CheckBox { text: "Поднимать сервер через ретранслятор"; checked <=> root.relay-enabled; enabled: !root.busy; }
                Hint { text: "При следующем запуске появится приглашение для друзей. Проброс портов не нужен. Локальное подключение остаётся доступным."; wrap: word-wrap; }
                spacing: 18px;
                HorizontalLayout {
                    spacing: 14px;
                    Field { label: "Начальный игровой порт"; value <=> root.port; enabled: !root.busy; error: root.error-field == "port" ? root.error : ""; }
                    Field { label: "Память сервера, МБ"; value <=> root.server-memory-setting; enabled: !root.busy; error: root.error-field == "smem" ? root.error : ""; }
                }
                Field { label: "Папка серверного комплекта"; value <=> root.server-path; folder: true; enabled: !root.busy; error: root.error-field == "server" ? root.error : ""; browse => { root.browse("server"); } }
            }
            if !root.wizard && root.tab == "updates": VerticalLayout {
                spacing: 18px;
                Label { text: "Ветка игры"; }
                ComboBox { model: root.branches; current-value <=> root.game-branch; enabled: !root.busy; height: 38px; }
                Hint { text: "Готовые сборки DeTTK/SCServer. Клиент и сервер обновляются вместе; Java и база карты повторно не скачиваются. Сохраните выбор перед обновлением."; wrap: word-wrap; overflow: clip; }
                HorizontalLayout {
                    alignment: start; spacing: 8px;
                    Action { label: "Проверить обновления"; enabled: !root.busy; activated => { root.update("check"); } }
                    Action { label: "Установить"; enabled: !root.busy && root.game-branch != ""; activated => { root.update("install"); } }
                }
            }
        }
    }
    if root.wizard && !root.busy && root.error == "" && root.status != "": Hint { text: root.status; wrap: word-wrap; overflow: clip; }
    if root.error != "" && !root.inline-error: Notice { message: root.error; failed: true; }
    if root.transfer-view.visible: TransferStatus { view: root.transfer-view; }
    if !root.transfer-view.visible && (root.busy || root.progress-text != ""): Notice {
        message: root.progress-text == "" ? "Выполняется операция…" : root.progress-text; progress: root.progress;
    }
    Rule {}
    HorizontalLayout {
        alignment: end; spacing: 8px; height: 38px;
        if root.wizard && !root.busy: Action { label: root.step > 0 ? "Назад" : "Закрыть"; activated => { root.step-action(root.step > 0 ? "back" : "close"); } }
        if root.wizard && root.busy: Action { label: "Отменить операцию"; activated => { root.step-action("cancel"); } }
        Action {
            label: root.wizard ? (root.step == 2 ? "Подготовить игру" : "Продолжить") : "Сохранить";
            enabled: !root.busy && (!root.wizard || root.step != 1 || root.bundle-path != ""); kind: "primary";
            activated => { if root.wizard { root.step-action(root.step == 2 ? "finish" : "next"); } else { root.save(); } }
        }
    }
}
