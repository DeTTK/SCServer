export struct WorldRow { id: string, title: string, detail: string }
export struct ServerRow { id: string, title: string, address: string, status: string, online: bool }
export struct ChangeRow { title: string, body: string }

export struct TransferView {
    visible: bool, operation: string, sequence: int,
    title: string, percent: string, fraction: float,
    downloaded: string, remaining: string, speed: string, eta: string, detail: string,
}

export struct AttachmentRow { id: string, name: string, detail: string }
export struct ModRow {
    id: string, title: string, description: string, version: string, side: string,
    source: string, required: bool, installed: bool, enabled: bool, update-available: bool, read-only: bool,
}
